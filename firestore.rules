rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: only the owner can read/write their own profile
    match /userProfiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Family-level rules (single-login model: one account per family,
    // children are profiles — no cross-family member login needed).
    match /families/{familyId} {
      // Helper: check if user is the parent (owner) of this family
      function isParent() {
        return request.auth != null &&
          resource.data.parentUid == request.auth.uid;
      }

      // Anyone authenticated can read families (for invite code lookup)
      // Only the parent can update/delete
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isParent();

      // Members subcollection
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
      }

      // Plans subcollection
      match /plans/{planId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
      }

      // Task logs subcollection
      match /taskLogs/{logId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
      }

      // Shop items subcollection
      match /shopItems/{itemId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }

      // Transactions subcollection (audit trail)
      match /transactions/{txId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }

      // Messages subcollection (parent -> kid notes and app nudges)
      match /messages/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        // Kid marks them seen; parent could edit/delete in future.
        allow update: if request.auth != null;
        allow delete: if request.auth != null;
      }
    }
  }
}
